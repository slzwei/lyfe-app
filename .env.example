# Supabase
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Sentry (error tracking)
EXPO_PUBLIC_SENTRY_DSN=https://your-dsn@sentry.io/project-id

# Lyfe SG domain (for invite URLs)
EXPO_PUBLIC_LYFE_SG_DOMAIN=lyfe.sg

# Google Maps SDK for Android — required for react-native-maps on Android.
# Baked into AndroidManifest.xml at prebuild time via app.config.js.
# iOS uses Apple MapKit and needs no key.
# Get the key at https://console.cloud.google.com/google/maps-apis
# Restrict the key to Android apps with package name com.shawnlee.lyfe.
GOOGLE_MAPS_ANDROID_API_KEY=your-android-key

# Google Places Autocomplete — used by the MapPicker's search field.
# Can be the SAME key as GOOGLE_MAPS_ANDROID_API_KEY as long as that key
# has the Places API (new) enabled in Google Cloud Console.
# Needs the EXPO_PUBLIC_ prefix so it's accessible to the JS runtime.
# SECURITY: this key ends up in the JS bundle. For production, proxy the
# Places API through a Supabase edge function so the key stays server-side.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your-places-key
