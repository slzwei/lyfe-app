{
    "cli": {
        "version": ">= 18.1.0",
        "appVersionSource": "remote"
    },
    "build": {
        "development": {
            "developmentClient": true,
            "distribution": "internal",
            "env": {
                "SENTRY_DISABLE_AUTO_UPLOAD": "true",
                "APP_VARIANT": "development"
            }
        },
        "preview": {
            "distribution": "internal",
            "env": {
                "SENTRY_DISABLE_AUTO_UPLOAD": "true",
                "APP_VARIANT": "preview"
            }
        },
        "testflight": {
            "distribution": "store",
            "channel": "testflight",
            "autoIncrement": true,
            "env": {
                "APP_VARIANT": "testflight"
            }
        },
        "production": {
            "channel": "production",
            "autoIncrement": true,
            "env": {
                "APP_VARIANT": "production"
            }
        }
    },
    "submit": {
        "production": {}
    }
}
