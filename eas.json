{
    "cli": {
        "version": ">= 18.1.0",
        "appVersionSource": "remote"
    },
    "build": {
        "development": {
            "developmentClient": true,
            "distribution": "internal",
            "env": {
                "SENTRY_DISABLE_AUTO_UPLOAD": "true",
                "APP_VARIANT": "development"
            }
        },
        "preview": {
            "distribution": "internal",
            "env": {
                "SENTRY_DISABLE_AUTO_UPLOAD": "true",
                "APP_VARIANT": "preview"
            }
        },
        "testflight": {
            "distribution": "store",
            "channel": "testflight",
            "autoIncrement": true,
            "env": {
                "APP_VARIANT": "testflight"
            }
        },
        "production": {
            "channel": "production",
            "autoIncrement": true,
            "env": {
                "APP_VARIANT": "production"
            }
        }
    },
    "submit": {
        "production": {
            "ios": {
                "appleTeamId": "Y953XF3N6C",
                "//": "Set via `eas secret:create EXPO_APPLE_API_KEY` (App Store Connect API key, .p8) — see docs/runbook-release-pipeline.md.",
                "ascAppId": "PUT_ASC_APP_ID_HERE"
            },
            "android": {
                "//": "Set via `eas secret:create GOOGLE_SERVICE_ACCOUNT` (Google Play service account JSON) — see docs/runbook-release-pipeline.md.",
                "serviceAccountKeyPath": "./google-play-service-account.json",
                "track": "internal"
            }
        }
    }
}
